# SPIKO.AI - Environment Variables

# ==============================================
# APP CONFIGURATION
# ==============================================

# Base URL - CHANGE THIS based on environment
# Development: http://localhost:3000
# Staging: https://staging.spiko.ai
# Production: https://spiko.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# SUPABASE
# ==============================================

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================
# AI SERVICES
# ==============================================

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the Claude model id
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Kimi K2 (Moonshot) — optional, for cheap prompt testing ----
# When present, the "Kimi K2" model option in Practice Setup works.
MOONSHOT_API_KEY=your_moonshot_api_key
# Defaults if omitted:
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k2.6

# Default LLM provider when a request doesn't specify one: anthropic | moonshot
# LLM_PROVIDER=anthropic

# ElevenLabs API Key (for voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ==============================================
# EMAIL SERVICE (Optional - for invitations)
# ==============================================

# Option 1: Resend (Recommended)
RESEND_API_KEY=your_resend_api_key

# Option 2: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# Option 3: Postmark
# POSTMARK_API_KEY=your_postmark_api_key

# Email Testing Mode
# IMPORTANT: Controls where invitation emails are sent
# 
# DEVELOPMENT/TESTING:
# Set to your email to receive ALL invitation emails (regardless of recipient)
# Example: EMAIL_TESTING_MODE=dash.crs@gmail.com
# 
# PRODUCTION:
# Leave EMPTY or comment out to send emails to actual recipients
# Example: EMAIL_TESTING_MODE=
#
EMAIL_TESTING_MODE=

# ==============================================
# DEPLOYMENT INFO
# ==============================================

# Environment: development | staging | production
NODE_ENV=development

# ==============================================
# NOTES
# ==============================================

# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to git
# 3. Update NEXT_PUBLIC_APP_URL for each environment
# 4. Staging/Production should use HTTPS URLs
