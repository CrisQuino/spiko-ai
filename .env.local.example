# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic Claude API (for AI chat)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Cloud TTS
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# TTS Configuration
# Set to 'true' to use Google TTS for free tier users (costs $0.16/user/month)
# Set to 'false' to use browser TTS for free tier (zero cost)
NEXT_PUBLIC_FREE_TIER_GOOGLE_TTS=false

# Cache Strategy
# Options: 'browser' (default) or 'filesystem'
# - 'browser': Client-side localStorage cache (0 RAM, recommended for development)
# - 'filesystem': Server-side disk cache (.cache/audio/, 0 RAM, shared across users)
# Note: Leave empty or set to 'browser' for browser caching (default)
CACHE_STRATEGY=browser

# Environment
NODE_ENV=development
