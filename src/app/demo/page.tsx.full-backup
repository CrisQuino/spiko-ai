'use client';

import { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import Link from 'next/link';
import { generateQuickFeedback, type CEFRAssessment } from '@/lib/cefr-evaluator';

type Message = {
  role: 'ai' | 'user';
  content: string;
  timestamp: number;
};

type Phase = 'intro' | 'diagnosis' | 'resolution' | 'verification' | 'complete';

export default function DemoPage() {
  const [started, setStarted] = useState(false);
  const [messages, setMessages] = useState<Message[]>([]);
  const [isRecording, setIsRecording] = useState(false);
  const [currentPhase, setCurrentPhase] = useState<Phase>('intro');
  const [progress, setProgress] = useState(0);
  const [userInput, setUserInput] = useState('');
  const [isPlayingAudio, setIsPlayingAudio] = useState(false);
  const [audioQueue, setAudioQueue] = useState<string[]>([]);
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const audioRef = useRef<HTMLAudioElement | null>(null);
  
  // Lesson tracking states
  const [lessonId, setLessonId] = useState<string | null>(null);
  const [startTime, setStartTime] = useState<number | null>(null);
  const [totalTokens, setTotalTokens] = useState({ input: 0, output: 0 });
  const [quickFeedback, setQuickFeedback] = useState<string[]>([]);
  const [cefrAssessment, setCefrAssessment] = useState<CEFRAssessment | null>(null);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages]);
  
  // Complete lesson when progress reaches 100%
  useEffect(() => {
    if (progress === 100 && lessonId && startTime && !cefrAssessment) {
      completeLesson();
    }
  }, [progress]);
  
  const completeLesson = async () => {
    if (!lessonId || !startTime) return;
    
    const durationSeconds = Math.floor((Date.now() - startTime) / 1000);
    const userMessages = messages.filter(m => m.role === 'user').map(m => m.content);
    
    try {
      const response = await fetch('/api/lesson/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lessonId,
          messages: userMessages,
          durationSeconds,
          tokenUsage: totalTokens
        })
      });
      
      if (response.ok) {
        const data = await response.json();
        setCefrAssessment(data.assessment);
      }
    } catch (error) {
      console.error('Error completing lesson:', error);
    }
  };

  const startScenario = async () => {
    setStarted(true);
    setStartTime(Date.now());
    
    // Start lesson tracking
    try {
      const response = await fetch('/api/lesson/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scenarioType: 'database' })
      });
      
      if (response.ok) {
        const data = await response.json();
        setLessonId(data.lessonId);
      }
    } catch (error) {
      console.error('Error starting lesson:', error);
    }
    
    // Initial AI message
    setTimeout(() => {
      addAIMessage(
        "Hey! Sorry to bother you, but we have a problem with the database. " +
        "Our reporting dashboard is showing data from like 2 hours ago, and customers " +
        "are starting to complain they can't see their recent orders. Can you take a look?"
      );
    }, 1000);
  };

  const addAIMessage = async (content: string) => {
    setMessages(prev => [...prev, {
      role: 'ai',
      content,
      timestamp: Date.now()
    }]);

    // Intentar generar y reproducir audio
    try {
      const response = await fetch('/api/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: content }),
      });

      const data = await response.json();

      if (data.audio && !data.fallback) {
        // Reproducir audio
        playAudio(data.audio);
      }
    } catch (error) {
      console.log('TTS not available, continuing without voice');
      // Continuar sin voz si falla
    }
  };

  const playAudio = (base64Audio: string) => {
    setIsPlayingAudio(true);
    
    // Crear elemento de audio
    const audio = new Audio(`data:audio/mpeg;base64,${base64Audio}`);
    audioRef.current = audio;

    audio.onended = () => {
      setIsPlayingAudio(false);
    };

    audio.onerror = () => {
      setIsPlayingAudio(false);
      console.error('Error playing audio');
    };

    audio.play().catch(err => {
      console.error('Failed to play audio:', err);
      setIsPlayingAudio(false);
    });
  };

  const handleUserMessage = () => {
    if (!userInput.trim()) return;

    // Add user message
    setMessages(prev => [...prev, {
      role: 'user',
      content: userInput,
      timestamp: Date.now()
    }]);

    // Simulate AI response based on conversation flow
    setTimeout(() => {
      respondToUser(userInput);
    }, 1500);

    setUserInput('');
    setProgress(prev => Math.min(prev + 25, 100));
  };

  const respondToUser = async (userMessage: string) => {
    try {
      // Llamar a la API real de Claude
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          messages: messages,
          scenario: 'db-replication-crisis',
        }),
      });

      if (!response.ok) {
        throw new Error('API call failed');
      }

      const data = await response.json();
      
      // Track token usage
      if (data.tokenUsage) {
        setTotalTokens(prev => ({
          input: prev.input + (data.tokenUsage.input || 0),
          output: prev.output + (data.tokenUsage.output || 0)
        }));
      }
      
      // Generate quick feedback
      const messageCount = messages.filter(m => m.role === 'user').length + 1;
      const feedback = generateQuickFeedback(userMessage, messageCount, 'database');
      if (feedback) {
        setQuickFeedback(prev => [...prev, feedback].slice(-3)); // Keep last 3
      }
      
      if (data.message) {
        addAIMessage(data.message);
        
        // Actualizar progreso basado en keywords de manera más gradual
        const lowerMessage = userMessage.toLowerCase();
        
        if (currentPhase === 'intro' && (lowerMessage.includes('check') || lowerMessage.includes('status') || lowerMessage.includes('replication'))) {
          setCurrentPhase('diagnosis');
          setProgress(20);
        } else if (currentPhase === 'diagnosis' && (lowerMessage.includes('process') || lowerMessage.includes('query') || lowerMessage.includes('blocking'))) {
          setCurrentPhase('resolution');
          setProgress(40);
        } else if (currentPhase === 'resolution' && (lowerMessage.includes('kill') || lowerMessage.includes('terminate') || lowerMessage.includes('stop'))) {
          setCurrentPhase('verification');
          setProgress(70);
          
          // Mensaje de éxito después de 3 segundos
          setTimeout(() => {
            addAIMessage("Perfect! The lag is now at 0 seconds. Reports are showing current data again. Thanks for the quick fix!");
          }, 3000);
        } else if (currentPhase === 'verification' && (lowerMessage.includes('monitor') || lowerMessage.includes('verify') || lowerMessage.includes('confirm') || lowerMessage.includes('good') || lowerMessage.includes('done'))) {
          setCurrentPhase('complete');
          setProgress(90);
          
          // Solo completar cuando el usuario confirme explícitamente
          setTimeout(() => {
            addAIMessage("Excellent work! You handled that crisis like a pro. The incident is now fully resolved.");
            setProgress(100);
          }, 2000);
        } else {
          // Incremento gradual basado en número de mensajes
          setProgress(prev => Math.min(prev + 5, 85)); // Nunca pasar de 85% automáticamente
        }
      }
    } catch (error) {
      console.error('Error getting AI response:', error);
      // Fallback a respuesta simple si la API falla
      addAIMessage("Sorry, I'm having trouble connecting. Can you try again?");
    }
  };

  const simulateRecording = () => {
    setIsRecording(true);
    
    // Verificar soporte del navegador
    // @ts-ignore - webkitSpeechRecognition no está en tipos de TS
    if (!('webkitSpeechRecognition' in window)) {
      alert('Voice recognition is only supported in Chrome, Edge, and Safari. Please use one of these browsers or type your response.');
      setIsRecording(false);
      return;
    }

    // @ts-ignore
    const recognition = new webkitSpeechRecognition();
    recognition.lang = 'en-US';
    recognition.continuous = false;
    recognition.interimResults = true;
    recognition.maxAlternatives = 1;

    recognition.onstart = () => {
      console.log('Voice recognition started. Speak now!');
    };

    recognition.onresult = (event: any) => {
      let interimTranscript = '';
      let finalTranscript = '';

      for (let i = event.resultIndex; i < event.results.length; i++) {
        const transcript = event.results[i][0].transcript;
        if (event.results[i].isFinal) {
          finalTranscript += transcript;
        } else {
          interimTranscript += transcript;
        }
      }

      // Mostrar transcripción en progreso
      if (interimTranscript) {
        setUserInput(interimTranscript);
      }

      // Cuando termina, guardar la transcripción final
      if (finalTranscript) {
        setUserInput(finalTranscript);
        setIsRecording(false);
      }
    };

    recognition.onerror = (event: any) => {
      console.error('Speech recognition error:', event.error);
      setIsRecording(false);
      
      if (event.error === 'not-allowed') {
        alert('Microphone access denied. Please allow microphone access in your browser settings.');
      } else if (event.error === 'no-speech') {
        alert('No speech detected. Please try again.');
      } else {
        alert(`Error: ${event.error}. Please try again or type your response.`);
      }
    };

    recognition.onend = () => {
      setIsRecording(false);
      console.log('Voice recognition ended.');
    };

    try {
      recognition.start();
    } catch (error) {
      console.error('Failed to start recognition:', error);
      setIsRecording(false);
      alert('Failed to start voice recognition. Please try again or type your response.');
    }
  };

  if (!started) {
    return (
      <div className="min-h-screen flex items-center justify-center px-6 relative overflow-hidden">
        {/* Tech Grid Background */}
        <div className="absolute inset-0 -z-10">
          <div className="absolute inset-0" style={{
            backgroundImage: `
              linear-gradient(90deg, rgba(16,185,129,0.03) 1px, transparent 1px),
              linear-gradient(rgba(16,185,129,0.03) 1px, transparent 1px)
            `,
            backgroundSize: '40px 40px'
          }}></div>
        </div>

        <div className="max-w-3xl w-full">
          <Link href="/" className="inline-flex items-center text-cyan-600 mb-8 hover:text-emerald-600 transition-colors font-mono text-sm">
            <span className="mr-2">←</span> cd ../home
          </Link>
          
          <motion.div
            initial={{ y: 30, opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
            className="glass rounded-2xl p-8 md:p-12 border border-gray-200"
          >
            {/* Icon */}
            <div className="w-20 h-20 bg-gradient-to-br from-emerald-500 via-cyan-500 to-blue-500 rounded-xl mx-auto mb-6 flex items-center justify-center text-white text-2xl font-mono shadow-xl">
              &lt;/&gt;
            </div>
            
            {/* Title with code style */}
            <div className="text-center mb-8">
              <div className="font-mono text-sm text-gray-500 mb-2">// scenario.demo()</div>
              <h1 className="text-3xl md:text-4xl font-bold mb-2">
                <span className="bg-gradient-to-r from-emerald-600 via-cyan-600 to-blue-600 bg-clip-text text-transparent font-mono">
                  Database Replication Crisis
                </span>
              </h1>
              <p className="text-gray-600 font-mono text-sm">
                production.incident = <span className="text-red-600">CRITICAL</span>
              </p>
            </div>
            
            <p className="text-lg text-gray-700 mb-8 text-center">
              You're the on-call DBA. Sarah (Product Manager) just called about an urgent issue.
              <br className="hidden md:block" />
              Practice handling this production incident in English.
            </p>

            {/* Code-style scenario details */}
            <div className="bg-gray-900 rounded-xl p-6 mb-8 text-left shadow-xl border border-gray-800">
              <div className="flex items-center space-x-2 mb-4">
                <div className="flex space-x-1.5">
                  <div className="w-3 h-3 rounded-full bg-red-500"></div>
                  <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
                  <div className="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <span className="text-gray-400 text-xs font-mono">scenario.config.js</span>
              </div>
              <pre className="text-sm font-mono overflow-x-auto">
                <code>
                  <span className="text-cyan-400">const</span> <span className="text-white">scenario</span> <span className="text-gray-500">=</span> <span className="text-yellow-300">{'{'}</span>{'\n'}
                  {'  '}<span className="text-emerald-400">duration</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'7-9 minutes'</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">difficulty</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'MEDIUM'</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">role</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'Database Administrator'</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">character</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'Sarah Chen (PM, stressed)'</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">issue</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'Reports showing 2-hour old data'</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">voice</span><span className="text-gray-500">:</span> <span className="text-purple-400">true</span><span className="text-gray-500">,</span>{'\n'}
                  {'  '}<span className="text-emerald-400">feedback</span><span className="text-gray-500">:</span> <span className="text-yellow-300">'real-time'</span>{'\n'}
                  <span className="text-yellow-300">{'}'}</span><span className="text-gray-500">;</span>
                </code>
              </pre>
            </div>

            <button
              onClick={startScenario}
              className="group w-full py-4 bg-gradient-to-r from-emerald-500 via-cyan-500 to-blue-500 text-white text-lg font-mono font-semibold rounded-xl hover:shadow-2xl transition-all hover:scale-[1.02] relative overflow-hidden"
            >
              <span className="relative z-10 flex items-center justify-center">
                <span className="mr-2">▶</span> scenario.start()
              </span>
              <div className="absolute inset-0 bg-gradient-to-r from-emerald-600 via-cyan-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </button>

            <p className="text-center text-sm text-gray-500 mt-4 font-mono">
              // Claude Sonnet 4 + Voice Synthesis
            </p>
          </motion.div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen flex flex-col bg-gradient-to-br from-gray-50 via-emerald-50/20 to-cyan-50/20">
      {/* Header */}
      <header className="glass border-b border-gray-200/50 backdrop-blur-xl">
        <div className="container mx-auto px-6 py-4">
          <div className="flex items-center justify-between">
            <div>
              <div className="flex items-center space-x-2 mb-1">
                <div className="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                <h1 className="text-xl font-mono font-bold bg-gradient-to-r from-emerald-600 to-cyan-600 bg-clip-text text-transparent">
                  Database Replication Crisis
                </h1>
              </div>
              <p className="text-sm text-gray-600 font-mono">
                <span className="text-gray-400">phase:</span> <span className="text-cyan-600">{currentPhase}</span> <span className="text-gray-400">|</span> <span className="text-gray-400">progress:</span> <span className="text-emerald-600">{progress}%</span>
              </p>
            </div>
            <div className="flex items-center space-x-4">
              <div className="text-right">
                <div className="text-xs text-gray-500 font-mono">elapsed</div>
                <div className="text-lg font-mono font-bold text-gray-800">4:23</div>
              </div>
              <button className="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors font-mono text-sm">
                exit()
              </button>
            </div>
          </div>
          
          {/* Progress Bar */}
          <div className="mt-4">
            <div className="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
              <motion.div
                className="bg-gradient-to-r from-emerald-500 via-cyan-500 to-blue-500 h-2 rounded-full"
                initial={{ width: 0 }}
                animate={{ width: `${progress}%` }}
                transition={{ duration: 0.5 }}
              />
            </div>
            <div className="flex justify-between text-xs text-gray-500 mt-1 font-mono">
              <span>intro</span>
              <span>diagnosis</span>
              <span>resolution</span>
              <span>closure</span>
            </div>
          </div>
          
          {/* Quick Feedback Panel */}
          {quickFeedback.length > 0 && (
            <motion.div
              initial={{ opacity: 0, y: -10 }}
              animate={{ opacity: 1, y: 0 }}
              className="mt-4 glass rounded-xl p-4 border border-cyan-500/30"
            >
              <div className="flex items-center space-x-2 mb-2">
                <span className="text-cyan-600">💡</span>
                <h4 className="font-mono text-sm font-bold text-gray-700">// live.feedback</h4>
              </div>
              <div className="space-y-1">
                {quickFeedback.map((fb, i) => (
                  <div key={i} className="text-sm text-gray-600 font-mono">
                    <span className="text-cyan-600">→</span> {fb}
                  </div>
                ))}
              </div>
            </motion.div>
          )}
        </div>
      </header>

      {/* Messages */}
      <div className="flex-1 overflow-y-auto px-6 py-8">
        <div className="container mx-auto max-w-4xl space-y-6">
          <AnimatePresence>
            {messages.map((message, index) => (
              <motion.div
                key={index}
                initial={{ y: 20, opacity: 0 }}
                animate={{ y: 0, opacity: 1 }}
                exit={{ y: -20, opacity: 0 }}
                className={`flex ${message.role === 'user' ? 'justify-end' : 'justify-start'}`}
              >
                <div className={`max-w-2xl ${message.role === 'user' ? 'order-2' : 'order-1'}`}>
                  {message.role === 'ai' && (
                    <div className="flex items-center space-x-2 mb-2">
                      <div className="w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center text-white text-xs font-mono shadow-lg">
                        SC
                      </div>
                      <span className="text-sm font-semibold font-mono">Sarah_Chen</span>
                      <span className="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                      <span className="text-xs text-gray-500 font-mono">online</span>
                    </div>
                  )}
                  
                  <div className={`rounded-xl px-6 py-4 ${
                    message.role === 'ai'
                      ? 'glass border border-gray-200/50'
                      : 'bg-gradient-to-r from-emerald-500 via-cyan-500 to-blue-500 text-white shadow-lg'
                  }`}>
                    <p className={`${message.role === 'user' ? 'font-mono text-sm' : 'text-base'}`}>
                      {message.role === 'user' && <span className="text-emerald-100 mr-2">&gt;</span>}
                      {message.content}
                    </p>
                    {message.role === 'ai' && isPlayingAudio && messages[messages.length - 1] === message && (
                      <div className="flex items-center space-x-2 mt-3 text-cyan-600">
                        <div className="flex space-x-1">
                          <div className="w-1 h-4 bg-cyan-500 rounded animate-pulse" style={{animationDelay: '0ms'}}></div>
                          <div className="w-1 h-4 bg-cyan-500 rounded animate-pulse" style={{animationDelay: '150ms'}}></div>
                          <div className="w-1 h-4 bg-cyan-500 rounded animate-pulse" style={{animationDelay: '300ms'}}></div>
                        </div>
                        <span className="text-sm font-mono">speaking...</span>
                      </div>
                    )}
                  </div>

                  {message.role === 'user' && (
                    <div className="flex items-center justify-end space-x-2 mt-2">
                      <span className="text-xs text-gray-500 font-mono">you@terminal</span>
                    </div>
                  )}
                </div>
              </motion.div>
            ))}
          </AnimatePresence>
          <div ref={messagesEndRef} />
        </div>
      </div>

      {/* Input Area */}
      <div className="glass border-t border-gray-200/50 backdrop-blur-xl">
        <div className="container mx-auto px-6 py-6">
          <div className="max-w-4xl mx-auto">
            {/* Live Feedback */}
            {userInput && (
              <motion.div
                initial={{ height: 0, opacity: 0 }}
                animate={{ height: 'auto', opacity: 1 }}
                className="bg-gray-900 rounded-xl p-4 mb-4 border border-gray-800"
              >
                <div className="text-sm space-y-2 font-mono">
                  <div className="flex items-start space-x-2">
                    <span className="text-emerald-500 mt-0.5">✓</span>
                    <span className="text-gray-300">Good technical vocabulary</span>
                  </div>
                  <div className="flex items-start space-x-2">
                    <span className="text-cyan-500 mt-0.5">💡</span>
                    <span className="text-gray-300">
                      <span className="text-gray-500">Try:</span> <span className="text-yellow-300">"Let me check the slave status"</span> <span className="text-gray-500">→ More specific</span>
                    </span>
                  </div>
                </div>
              </motion.div>
            )}

            {/* Input Box */}
            <div className="flex items-center space-x-4">
              <button
                onClick={simulateRecording}
                className={`flex-shrink-0 w-14 h-14 rounded-lg flex items-center justify-center transition-all font-mono text-xl shadow-lg ${
                  isRecording
                    ? 'bg-red-500 animate-pulse text-white'
                    : 'bg-gradient-to-r from-emerald-500 via-cyan-500 to-blue-500 hover:scale-110 text-white'
                }`}
              >
                {isRecording ? '⏺' : '🎤'}
              </button>

              <div className="flex-1 flex items-center space-x-2">
                <div className="flex-1 relative">
                  <span className="absolute left-4 top-1/2 -translate-y-1/2 text-emerald-600 font-mono">$</span>
                  <input
                    type="text"
                    value={userInput}
                    onChange={(e) => setUserInput(e.target.value)}
                    onKeyPress={(e) => e.key === 'Enter' && handleUserMessage()}
                    placeholder="type your response..."
                    className="w-full pl-10 pr-6 py-4 glass rounded-xl font-mono text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 border border-gray-200/50"
                  />
                </div>
                <button
                  onClick={handleUserMessage}
                  disabled={!userInput.trim()}
                  className="px-6 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 text-white rounded-xl hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed transition-all font-mono text-sm"
                >
                  send()
                </button>
              </div>
            </div>

            <div className="mt-4 flex items-center justify-between text-sm font-mono">
              <div className="flex items-center space-x-2">
                <span className="text-cyan-600">💡</span>
                <span className="text-gray-500">hint:</span>
                <span className="text-gray-700">"Let me check the replication status"</span>
              </div>
              <div>
                {isRecording && (
                  <span className="text-red-500 flex items-center space-x-2">
                    <span className="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                    <span>recording...</span>
                  </span>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Completion Modal */}
      <AnimatePresence>
        {progress === 100 && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center px-6 z-50"
          >
            <motion.div
              initial={{ scale: 0.9, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              className="glass rounded-2xl p-8 md:p-12 max-w-3xl w-full border border-gray-200/50 shadow-2xl"
            >
              <div className="text-center">
                <div className="text-6xl mb-6">🎉</div>
                <h2 className="text-3xl md:text-4xl font-bold mb-2 font-mono gradient-text">
                  scenario.complete()
                </h2>
                <p className="text-lg text-gray-600 mb-8 font-mono text-sm">
                  <span className="text-gray-400">// </span>Great job handling that database crisis!
                </p>

                {/* Performance Metrics with CEFR */}
                {cefrAssessment ? (
                  <>
                    <div className="bg-gray-900 rounded-xl p-6 mb-8 text-left border border-gray-800">
                      <div className="flex items-center space-x-2 mb-4">
                        <div className="flex space-x-1.5">
                          <div className="w-3 h-3 rounded-full bg-red-500"></div>
                          <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
                          <div className="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <span className="text-gray-400 text-xs font-mono">performance.json</span>
                      </div>

                      <pre className="text-sm font-mono overflow-x-auto">
                        <code>
                          <span className="text-cyan-400">const</span> <span className="text-white">assessment</span> <span className="text-gray-500">=</span> <span className="text-yellow-300">{'{'}</span>{'\n'}
                          {'  '}<span className="text-emerald-400">cefr_level</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;{cefrAssessment.overall.level}&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Overall proficiency</span>{'\n'}
                          {'  '}<span className="text-emerald-400">fluency</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;{cefrAssessment.fluency.level}&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Conversation flow</span>{'\n'}
                          {'  '}<span className="text-emerald-400">technical_jargon</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;{cefrAssessment.technicalJargon.level}&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Domain vocabulary</span>{'\n'}
                          {'  '}<span className="text-emerald-400">communication</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;{cefrAssessment.interaction.level}&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Incident response</span>{'\n'}
                          <span className="text-yellow-300">{'}'}</span><span className="text-gray-500">;</span>
                        </code>
                      </pre>
                    </div>

                    {/* Detailed Breakdown */}
                    <div className="grid md:grid-cols-2 gap-4 mb-8 text-left">
                      <div className="glass rounded-xl p-4 border border-gray-200/50">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-sm font-mono text-gray-600">CEFR Level</span>
                          <span className="text-2xl font-mono font-bold gradient-text">{cefrAssessment.overall.level}</span>
                        </div>
                        <p className="text-xs text-gray-500">{cefrAssessment.overall.description}</p>
                      </div>

                      <div className="glass rounded-xl p-4 border border-gray-200/50">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-sm font-mono text-gray-600">Technical Jargon</span>
                          <span className="tech-badge-emerald">{cefrAssessment.technicalJargon.level}</span>
                        </div>
                        <p className="text-xs text-gray-500">{cefrAssessment.technicalJargon.termsUsed.length} technical terms used</p>
                      </div>

                      <div className="glass rounded-xl p-4 border border-gray-200/50">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-sm font-mono text-gray-600">Fluency</span>
                          <span className="text-xl font-mono font-bold text-emerald-600">{cefrAssessment.fluency.level}</span>
                        </div>
                        <p className="text-xs text-gray-500">Score: {cefrAssessment.fluency.score}/100</p>
                      </div>

                      <div className="glass rounded-xl p-4 border border-gray-200/50">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-sm font-mono text-gray-600">Vocabulary</span>
                          <span className="text-xl font-mono font-bold text-cyan-600">{cefrAssessment.vocabulary.level}</span>
                        </div>
                        <p className="text-xs text-gray-500">Score: {cefrAssessment.vocabulary.score}/100</p>
                      </div>
                    </div>

                    {/* Final Feedback */}
                    {cefrAssessment.finalFeedback && (
                      <div className="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-8 text-left">
                        <h3 className="font-mono text-sm font-bold text-blue-900 mb-2">// detailed_feedback</h3>
                        <p className="text-sm text-gray-700 whitespace-pre-line">{cefrAssessment.finalFeedback}</p>
                      </div>
                    )}
                  </>
                ) : (
                  <div className="py-8">
                    <div className="w-12 h-12 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p className="text-gray-500 font-mono text-sm">// calculating_assessment()</p>
                  </div>
                )}

                  <pre className="text-sm font-mono overflow-x-auto">
                    <code>
                      <span className="text-cyan-400">const</span> <span className="text-white">assessment</span> <span className="text-gray-500">=</span> <span className="text-yellow-300">{'{'}</span>{'\n'}
                      {'  '}<span className="text-emerald-400">cefr_level</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;B2&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Upper Intermediate</span>{'\n'}
                      {'  '}<span className="text-emerald-400">fluency</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;B2+&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Strong conversational ability</span>{'\n'}
                      {'  '}<span className="text-emerald-400">technical_jargon</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;Advanced&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Database terminology</span>{'\n'}
                      {'  '}<span className="text-emerald-400">communication</span><span className="text-gray-500">:</span> <span className="text-yellow-300">&apos;B2&apos;</span><span className="text-gray-500">,</span> <span className="text-gray-500">// Clear incident response</span>{'\n'}
                      <span className="text-yellow-300">{'}'}</span><span className="text-gray-500">;</span>
                    </code>
                  </pre>
                </div>

                {/* Detailed Breakdown */}
                <div className="grid md:grid-cols-2 gap-4 mb-8 text-left">
                  {/* CEFR Level */}
                  <div className="glass rounded-xl p-4 border border-gray-200/50">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-sm font-mono text-gray-600">CEFR Level</span>
                      <span className="text-2xl font-mono font-bold gradient-text">B2</span>
                    </div>
                    <p className="text-xs text-gray-500">Upper Intermediate - Can handle complex technical discussions</p>
                  </div>

                  {/* Technical Jargon */}
                  <div className="glass rounded-xl p-4 border border-gray-200/50">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-sm font-mono text-gray-600">Technical Jargon</span>
                      <span className="tech-badge-emerald">Advanced</span>
                    </div>
                    <p className="text-xs text-gray-500">Strong use of database-specific terminology</p>
                  </div>

                  {/* Fluency */}
                  <div className="glass rounded-xl p-4 border border-gray-200/50">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-sm font-mono text-gray-600">Fluency</span>
                      <span className="text-xl font-mono font-bold text-emerald-600">B2+</span>
                    </div>
                    <p className="text-xs text-gray-500">Smooth conversation flow with minimal pauses</p>
                  </div>

                  {/* Communication */}
                  <div className="glass rounded-xl p-4 border border-gray-200/50">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-sm font-mono text-gray-600">Communication</span>
                      <span className="text-xl font-mono font-bold text-cyan-600">B2</span>
                    </div>
                    <p className="text-xs text-gray-500">Clear incident explanation and problem-solving</p>
                  </div>
                </div>

                {/* Action Buttons */}
                <div className="flex flex-col sm:flex-row gap-4">
                  <Link
                    href="/"
                    className="flex-1 py-3 glass border-2 border-gray-300 rounded-xl font-mono font-semibold hover:border-cyan-500 hover:shadow-xl transition-all text-center"
                  >
                    <span className="mr-2">←</span> cd ../home
                  </Link>
                  <button
                    onClick={() => window.location.reload()}
                    className="flex-1 py-3 bg-gradient-to-r from-emerald-500 via-cyan-500 to-blue-500 text-white rounded-xl font-mono font-semibold hover:shadow-xl transition-all"
                  >
                    <span className="mr-2">&gt;</span> retry()
                  </button>
                </div>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
